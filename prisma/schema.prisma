generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  qrCodes   QRCode[]
  shortUrls ShortUrl[]
}

enum QRLifecycleStatus {
  active
  archived
  retired
}

model QRCode {
  lifecycleStatus QRLifecycleStatus @default(active)
  id          String   @id @default(uuid())
  title       String
  description String?
  data        String   // The actual data/URL encoded in QR
  size        Int      @default(300)
  fgColor     String   @default("#000000")
  bgColor     String   @default("#FFFFFF")
  errorLevel  String   @default("M") // L, M, Q, H
  issuedEncodedTarget String? @db.Text
  imageUrl    String?  // URL to the generated QR image
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  shortUrlId  String?  @unique
  shortUrl    ShortUrl? @relation(fields: [shortUrlId], references: [id])
  
  analytics   Analytics[]
}

model ShortUrl {
  id          String   @id @default(uuid())
  shortCode   String   @unique
  originalUrl String
  createdAt   DateTime @default(now())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  qrCode      QRCode?
  analytics   Analytics[]
}

model Analytics {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  userAgent String?
  ipAddress String?
  
  qrCodeId  String?
  qrCode    QRCode?  @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  
  shortUrlId String?
  shortUrl   ShortUrl? @relation(fields: [shortUrlId], references: [id], onDelete: Cascade)
}
// Application-owned isolated recovery proposal; never an Auth/User ownership FK.
model RecoverySubject {
  environment  String
  project      String
  subject      String
  generation   Int
  state        String
  version      Int?
  purpose      String?
  selector     String? @unique
  email        String?
  recipientId  String?
  keyId        String?
  secretDigest String?
  proofMac     String?
  issuedAtMs   BigInt?
  expiresAtMs  BigInt?
  operationId  String? @unique
  terminalAtMs BigInt?

  @@id([environment, project, subject])
  @@index([state, expiresAtMs])
}

model RecoveryAdmission {
  environment String
  project     String
  recipientId String
  subject     String?
  state       String
  operationId String? @unique
  issuedAtMs  BigInt?

  @@id([environment, project, recipientId])
  @@index([state, issuedAtMs])
}

model RecoveryBudget {
  environment String
  project     String
  scope       String
  key         String
  windowMs    BigInt
  attempts    Int

  @@id([environment, project, scope, key])
  @@index([windowMs])
}
