{
  "name": "qr-code-manager",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "prisma generate && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:auth": "node --experimental-vm-modules --test tests/auth-account.test.mjs tests/auth-admission.test.mjs tests/recovery-foundation.test.mjs tests/recovery-integration.test.mjs",
    "test:recovery:pg": "node --test tests/recovery-ledger.pg.test.mjs",
    "test:keepalive": "node --experimental-vm-modules --test tests/keepalive.test.mjs",
    "test:qr": "node --experimental-vm-modules --test tests/qr-contract.test.mjs tests/qr-provenance.test.mjs tests/qr-consumers.test.mjs tests/qr-edit.test.mjs tests/qr-redirect.test.mjs tests/qr-lifecycle.test.mjs"
  },
  "dependencies": {
    "@nuxtjs/supabase": "^2.0.3",
    "@prisma/client": "^5.22.0",
    "chart.js": "^4.5.1",
    "nanoid": "^5.1.6",
    "nuxt": "^4.3.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/node": "^25.2.2",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^17.2.4"
  }
}
