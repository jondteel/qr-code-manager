DATABASE_URL="postgresql://user:password@host:5432/database"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-key"
CRON_SECRET="replace-with-a-long-random-secret"
# F1: production authority additionally requires VERCEL=1 + VERCEL_ENV=production.
# Local isolated issuance requires NODE_ENV=development or test; unknown stage fails closed.
# Explicit isolated example only. Production requires environment=production and
# origin=https://scanlytics.vercel.app. Configure privately on the server.
NUXT_QR_ISSUANCE_ORIGIN="https://issuer.example.invalid"
NUXT_QR_ISSUANCE_ENVIRONMENT="isolated"
# F2 private controls. Leave disabled until independently verified for this issuer.
NUXT_QR_LEGACY_CANONICAL_REGEN_ENABLED="false"
# Empty by default. After route + same-mapping-store verification, the operator
# assertion is: <issuance-environment>|<issuance-origin>/s/[code]|same-store-v1
# This declaration is not itself evidence; production activation is separate.
NUXT_QR_LEGACY_CANONICAL_COMPATIBILITY=""
